# Copie para .env NA RAIZ DO PROJETO (o systemd lê de lá: EnvironmentFile).
# NUNCA no git. Permissão 600, dono deploy.
#
# Endereço público: canonical, sitemap, og:url. O criar-site.sh grava sozinho.
# *.projetos.luizaugust.me sai do Google automaticamente.
CORTESAM_SITE=https://cortesam.projetos.luizaugust.me
# sim | nao — força a decisão de indexar (em branco: decide pelo endereço)
CORTESAM_INDEXAR=
# Assina as fichas dos formulários e os links de confirmação.
# Em branco: nasce em data/segredo.txt no primeiro boot (e entra no backup).
CORTESAM_SEGREDO=
# Aviso por e-mail de agendamento e mensagem:
# smtps://usuario:senha@smtp.provedor.com:465
CORTESAM_SMTP=
CORTESAM_SMTP_DE=
