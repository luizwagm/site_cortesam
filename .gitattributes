# Fim de linha: .sh com CRLF chega ao servidor como "interpretador não
# encontrado". Estes tipos nascem e continuam com LF em qualquer máquina.
* text=auto

*.sh       text eol=lf
*.service  text eol=lf
*.timer    text eol=lf
*.conf     text eol=lf

*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.avif  binary
*.ico   binary
*.woff2 binary
*.db    binary
*.pdf   binary
