[Unit]
Description=Corte Sam — cópia de segurança do banco

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/var/www/projetos/Corte-Sam
ExecStart=/usr/bin/node ferramentas/backup.cjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# O backup do SQLite em WAL precisa escrever na pasta do banco (checkpoint).
ReadWritePaths=-/var/www/projetos/Corte-Sam/data
ReadWritePaths=-/var/www/projetos/Corte-Sam/backups
